# ── App ────────────────────────────────────────────────
APP_NAME=Agent Eval Pipeline
APP_VERSION=1.0.0
DEBUG=false

# ── Database ───────────────────────────────────────────
# Inside Docker: use service name "postgres"
# Locally without Docker: use localhost
DATABASE_URL=postgresql://evaluser:evalpass@postgres:5432/evaldb

# ── Redis ──────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── LLM (Ollama) ───────────────────────────────────────
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
LLM_CACHE_TTL_SECONDS=86400

# ── Evaluation ─────────────────────────────────────────
# Minimum pattern occurrences before self-updater fires
SELF_UPDATER_MIN_OCCURRENCES=3
# Confidence threshold for auto-labeling annotations
ANNOTATION_AUTO_LABEL_THRESHOLD=0.7
